# Domain
# This would be set to the production domain with an env var on deployment
# used by Traefik to transmit traffic and aqcuire TLS certificates
DOMAIN=localhost
# To test the local Traefik config
# DOMAIN=localhost.tiangolo.com

# Used for CORS - the frontend origin the backend accepts requests from
FRONTEND_HOST=http://localhost:5173
# In staging and production, set this env var to the frontend host, e.g.
# FRONTEND_HOST=https://dashboard.example.com

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME=Gainbridge
STACK_NAME=gainbridge

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173,http://localhost.tiangolo.com"

# SQLITE_DB_FILE / LOG_FILE default to ../data/gainbridge.{db,log} (a
# top-level data/ folder, bind-mounted to ./data by compose.yml so data
# survives redeploys) - override here only if you want a different path.

# IANA zone name (e.g. America/Toronto) that source schedule_cron
# expressions are evaluated in, so "0 23 * * *" means 11 PM in this zone
# rather than UTC. Auto-detected from TZ or the container's system
# timezone (see the /etc/localtime and /etc/timezone mounts in the
# docker run example in the README) if unset - override here only if
# that detection picks the wrong zone.
# TIMEZONE=America/Toronto

SENTRY_DSN=

# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
